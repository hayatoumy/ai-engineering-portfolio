{
  "name": "ai-engineer-bootcamp",
  "image": "mcr.microsoft.com/devcontainers/universal:2-linux",
  "hostRequirements": {
    "cpus": 2
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "ms-azuretools.vscode-docker",
        "tamasfe.even-better-toml"
      ]
    }
  },
  "postCreateCommand": "pip install --upgrade pip uv"
}